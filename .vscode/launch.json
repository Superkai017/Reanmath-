{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI (debug) + Vite UI",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["src.api:app", "--host", "0.0.0.0", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "jinja": true,
      "justMyCode": true,
      "preLaunchTask": "Frontend: Vite",
      "serverReadyAction": {
        "pattern": "Uvicorn running on",
        "uriFormat": "http://localhost:3000",
        "action": "openExternally"
      }
    },
    {
      "name": "FastAPI (debug only)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["src.api:app", "--host", "0.0.0.0", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "jinja": true,
      "justMyCode": true,
      "serverReadyAction": {
        "pattern": "Uvicorn running on",
        "uriFormat": "http://localhost:8000",
        "action": "openExternally"
      }
    },
    {
      "name": "Pytest (debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-x", "-q"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "justMyCode": false
    }
  ]
}
