{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: FastAPI",
      "detail": "uvicorn on http://localhost:8000 (reloads on save)",
      "type": "shell",
      "command": "uv run uvicorn src.api:app --reload --host 0.0.0.0 --port 8000",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "presentation": { "panel": "dedicated", "group": "dev", "reveal": "always" },
      "problemMatcher": {
        "owner": "uvicorn",
        "pattern": { "regexp": "^(ERROR):\\s+(.*)$", "severity": 1, "message": 2 },
        "background": {
          "activesBegin": "Will watch for changes|Started reloader process",
          "endsPattern": "Application startup complete|Uvicorn running on"
        }
      }
    },
    {
      "label": "Frontend: Vite",
      "detail": "UI on http://localhost:3000, proxies /api to FastAPI",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/Frontend" },
      "isBackground": true,
      "presentation": { "panel": "dedicated", "group": "dev", "reveal": "always" },
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^\\s*error\\s+(.*)$", "message": 1 },
        "background": {
          "activesBegin": "> vite",
          "endsPattern": "ready in|Local:"
        }
      }
    },
    {
      "label": "Dev: backend + frontend",
      "detail": "Start FastAPI and Vite together, then open http://localhost:3000",
      "dependsOn": ["Backend: FastAPI", "Frontend: Vite"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Frontend: install",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/Frontend" },
      "problemMatcher": []
    },
    {
      "label": "Test: pytest",
      "type": "shell",
      "command": "uv run pytest",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true }
    }
  ]
}
