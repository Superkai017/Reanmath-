# ---------------------------------------------------------------------------
# Reanmath RAG configuration. Copy to .env and fill in what you need.
# Every key is optional; the values below are the defaults.
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
LOG_LEVEL=INFO
# Comma-separated list of allowed browser origins ("*" allows any origin).
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
MAX_UPLOAD_MB=25

# --- Answer generation --------------------------------------------------------
# auto      -> Anthropic if ANTHROPIC_API_KEY is set, else Gemini if GEMINI_API_KEY
#              is set, else "none"
# none      -> no LLM; the API returns the best-matching curriculum passages
LLM_PROVIDER=auto
LLM_MAX_TOKENS=16000
LLM_TIMEOUT_SECONDS=300

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high
# Let the API retry on its default fallback model if the main model declines.
ANTHROPIC_FALLBACKS=true

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TEMPERATURE=0.2

# --- Embeddings ---------------------------------------------------------------
# sentence-transformers -> dense multilingual model (downloaded on first use)
# hashing               -> offline lexical feature hashing, no model download
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
HASHING_DIM=1024
# Load the embedding model at startup instead of on the first request.
PRELOAD_EMBEDDER=false

# --- Storage ------------------------------------------------------------------
# Relative paths are resolved against the project root.
VECTOR_STORE_PATH=storage/vector_index
DATA_DIR=data

# --- Ingestion ----------------------------------------------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=50
# auto -> khmer-nltk CRF word segmentation when installed, else regex clusters
KHMER_SEGMENTER=auto

# --- OCR for scanned PDFs and uploaded images ----------------------------------
# auto   -> OCR only pages whose text layer has fewer than OCR_MIN_CHARS characters
# always -> OCR every PDF page (use for PDFs with broken legacy Khmer fonts)
# never  -> no OCR (image uploads are rejected)
OCR_MODE=auto
# Which OCR engine reads the pages:
# auto   -> Gemini vision if GEMINI_API_KEY is set, else Kiri OCR if installed
# gemini -> Gemini vision: Khmer text + formulas as LaTeX (needs GEMINI_API_KEY)
# kiri   -> Kiri OCR, local and free, Khmer words only (no formulas)
OCR_ENGINE=auto

# Gemini OCR
OCR_MODEL=gemini-3.5-flash
OCR_MIN_CHARS=20
OCR_CONCURRENCY=4
OCR_MAX_RETRIES=4
# minimal | low | medium | high
OCR_THINKING_LEVEL=low
# Page transcripts are cached here (one .md file per page) and can be reviewed.
OCR_CACHE_DIR=storage/ocr_cache

# Kiri OCR (https://github.com/mrrtmob/kiri-ocr; model downloads on first use)
KIRI_MODEL=mrrtmob/kiri-ocr
# cpu | cuda
KIRI_DEVICE=cpu
# fast | accurate | beam  (beam is best and slowest)
KIRI_DECODE_METHOD=accurate
# Lines recognised with lower confidence (0-1) are dropped. The published model
# scores even clean lines around 0.4-0.45, so keep this well below that.
KIRI_MIN_CONFIDENCE=0.2
# Keep only Khmer words (drops Latin letters, digits and math symbols Kiri misreads).
KIRI_KHMER_ONLY=true
# Zoom used to render PDF pages that are not a single scanned image.
KIRI_RENDER_SCALE=2.0

# --- Retrieval ----------------------------------------------------------------
TOP_K=5
# Cosine similarity cut-off. E5 models score related passages around 0.75-0.9;
# lower this (e.g. 0.2) when using EMBEDDING_BACKEND=hashing.
SCORE_THRESHOLD=0.75
MAX_CONTEXT_CHARS=12000
